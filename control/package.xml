<?xml version="1.0"?>
<package format="3">
  <name>farmsim_control</name>
  <version>0.1.0</version>
  <description>Row-following controllers (pd, pure_pursuit, stanley, bangbang, fuzzy) outputting linear and angular velocity, plus the path-following ROS node.</description>
  <maintainer email="thiago.medeiros.carvalho@gmail.com">thiane</maintainer>
  <license>BSD</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>farmsim_farm</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
