<?xml version="1.0"?>
<package format="3">
  <name>thorvald_bringup</name>
  <version>2.0.0</version>
  <description>Top-level bringup launch files for Thorvald II robot variants</description>
  <maintainer email="gbr.tenorio@gmail.com">Gbrtenorio</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>thorvald_model</exec_depend>
  <exec_depend>thorvald_teleop</exec_depend>
  <exec_depend>thorvald_twist_mux</exec_depend>
  <exec_depend>thorvald_base_driver</exec_depend>
  <exec_depend>thorvald_io_serial</exec_depend>
  <exec_depend>thorvald_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
