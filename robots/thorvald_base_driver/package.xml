<?xml version="1.0"?>
<package format="3">
  <name>thorvald_base_driver</name>
  <version>2.0.0</version>
  <description>Hardware driver node for the Thorvald II robot base (ROS2 Humble port)</description>
  <maintainer email="gbr.tenorio@gmail.com">Gbrtenorio</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pluginlib</depend>
  <depend>thorvald_msgs</depend>
  <depend>thorvald_can_devices</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
