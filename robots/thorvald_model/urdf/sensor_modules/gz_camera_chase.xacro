<?xml version="1.0"?>
<!--
  gz_camera.xacro plus a third-person chase camera behind and above the robot,
  for videos of control runs (run_control.py run.video=true). The chase camera
  has no visual or collision, so it does not appear in the front camera.
  farm_sim.launch.py bridges its /chase_camera topic.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gz_camera_chase">
  <xacro:include filename="$(find thorvald_model)/urdf/sensor_modules/gz_camera.xacro" />

  <link name="${tf_prefix}chase_camera_link">
    <inertial>
      <mass value="0.01" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>
  <joint name="${tf_prefix}chase_camera_joint" type="fixed">
    <parent link="${tf_prefix}base_link" />
    <child link="${tf_prefix}chase_camera_link" />
    <origin xyz="-3.6 0 2.9" rpy="0 0.52 0" />
  </joint>
  <gazebo reference="${tf_prefix}chase_camera_link">
    <sensor name="chase_camera" type="camera">
      <camera>
        <horizontal_fov>1.25</horizontal_fov>
        <image><width>960</width><height>540</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>60</far></clip>
      </camera>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>chase_camera</topic>
    </sensor>
  </gazebo>
</robot>
