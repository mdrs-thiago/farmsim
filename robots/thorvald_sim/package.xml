<?xml version="1.0"?>
<package format="3">
  <name>thorvald_sim</name>
  <version>0.0.1</version>
  <description>Thorvald II simulation bringup for Gazebo Classic (ROS2 Humble)</description>
  <maintainer email="todo@todo.com">TODO</maintainer>
  <license>BSD</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>gazebo_ros</depend>
  <depend>controller_manager</depend>
  <depend>thorvald_model</depend>
  <depend>thorvald_base</depend>
  <depend>imrt_virtual_joy</depend>
  <depend>imrt_teleop</depend>

  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
