<?xml version="1.0"?>
<package format="3">
  <name>farmsim_perception</name>
  <version>0.1.0</version>
  <description>
    Row perception: CNN / CNN-LSTM models and their training, ground-truth
    label rendering and dataset export, and the perception ROS node.
  </description>
  <maintainer email="thiago.medeiros.carvalho@gmail.com">thiane</maintainer>
  <license>BSD</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>farmsim_farm</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
