<?xml version="1.0"?>
<!--
  gz-sim (new Gazebo) port of ros_src/wide_thorvald/worlds/volleveien_20250425.world
  (Gazebo Classic). This survey's mesh was NOT re-centered at export time
  (unlike the 20250624/20260331 dates), so ros_src's world file applies a
  large pose offset via <include><pose> to bring it to roughly (0,0,~0) in
  world coordinates; that offset is carried over unchanged here. Requires
  GZ_SIM_RESOURCE_PATH to include the ros_src directory so that
  model://20250425_vollveien_06gsd resolves to
  ros_src/20250425_vollveien_06gsd/ (model.sdf + odm_textured_model_geo.obj).
-->
<sdf version="1.8">
  <world name="vollebekk_farm_20250425">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.95 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Vollebekk farm terrain, 2025-04-25 survey, 6cm GSD photogrammetry.
         Pose re-centers the raw ODM export to roughly (0,0,~0) here, same
         offset as ros_src's Classic-Gazebo world file. -->
    <include>
      <uri>model://20250425_vollveien_06gsd</uri>
      <pose>33.8 -13.8 -116.9 0 0 1.066</pose>
    </include>

  </world>
</sdf>
