<?xml version="1.0"?>
<!--
  gz-sim (new Gazebo) port of ros_src/wide_thorvald/worlds/volleveien_20250624.world
  (Gazebo Classic). Terrain model block is unchanged from that file (plain
  static mesh, no plugins); only the world-level boilerplate (sdf version,
  physics tag, required gz-sim system plugins) is new. Requires
  GZ_SIM_RESOURCE_PATH to include the ros_src directory so that
  model://20250624_vollveien_06gsd resolves to
  ros_src/20250624_vollveien_06gsd/.
-->
<sdf version="1.8">
  <world name="vollebekk_farm_20250624">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Vollebekk farm terrain, 2025-06-24 survey, 6cm GSD photogrammetry -->
    <model name="20250624_vollveien_06gsd">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://20250624_vollveien_06gsd/20250624_vollveien_06GSD.obj</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://20250624_vollveien_06gsd/20250624_vollveien_06GSD.obj</uri>
            </mesh>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <friction>
              <ode/>
            </friction>
          </surface>
        </collision>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- birdseye_camera used to be a permanent fixture here, but it
         collided with the robot's own front_camera on gz-sim's shared
         /camera_info topic whenever farm_sim.launch.py spawned the
         robot into this same world (see worlds/birdseye_camera.sdf for
         the full explanation and history) -- it's now spawned
         dynamically, only by capture_topdown.launch.py, via
         `ros_gz_sim create -file worlds/birdseye_camera.sdf`. -->

  </world>
</sdf>
